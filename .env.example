# Database. Leave unset for SQLite at data/base-suite.db (no server needed).
# Postgres: DATABASE_URL='postgresql://user:password@host:5432/dbname'
# DATABASE_URL=''

# Where uploaded images are stored (served at /media). Default: data/uploads
# MEDIA_DIR='data/uploads'

# Stripe secret key. Optional: without it the subscriptions module shows plans but cannot check out.
# PRIVATE_STRIPE_API_KEY='sk_live_...'
# Stripe webhook signing secret (Stripe -> Developers -> Webhooks). Fills Admin -> Subscriptions.
# PRIVATE_STRIPE_WEBHOOK_SECRET='whsec_...'

# Email (Resend). Optional: without it sign-up skips verification, password reset is unavailable
# and the newsletter is single opt-in.
# PRIVATE_RESEND_API_KEY='re_...'
# PRIVATE_FROM_EMAIL='no_reply@example.com'
# Admin alerts (new chats, contact requests) go here, sent from PRIVATE_FROM_ADMIN_EMAIL.
# PRIVATE_ADMIN_EMAIL='you@example.com'
# PRIVATE_FROM_ADMIN_EMAIL='no_reply@example.com'

# Sign-in with Google or GitHub. Keys are normally entered in Admin -> Sign-in; these override that.
# PRIVATE_GOOGLE_CLIENT_ID='...'
# PRIVATE_GOOGLE_CLIENT_SECRET='...'
# PRIVATE_GITHUB_CLIENT_ID='...'
# PRIVATE_GITHUB_CLIENT_SECRET='...'
# Encrypts client secrets saved in Admin -> Sign-in. Unset: a key file is created at data/secrets.key.
# Required on hosts without a writable disk. Changing it means entering the secrets again.
# PRIVATE_SECRETS_KEY='a long random string'

# Lets the first sign-up become admin on a deployed site: the sign-up form asks for this code while
# there is no admin. Locally the first account is admin without it. Unset in production: no one can claim it.
# PRIVATE_SETUP_CODE='a code only you know'

# Protects /api/cron, which the Cloudflare Cron Trigger calls to send booking reminders and retry webhooks.
# CRON_SECRET='a long random string'

# Cloudflare Turnstile on the comment form: the widget's site key (public) and secret.
# PUBLIC_TURNSTILE_SITE_KEY='0x...'
# TURNSTILE_SECRET_KEY='0x...'

# Optional Cloudflare Access in front of /admin: your team domain and the application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN='yourteam.cloudflareaccess.com'
# CF_ACCESS_AUD='the Application Audience (AUD) tag'

# Calendly webhook signing key. Fills Admin -> Bookings.
# PRIVATE_CALENDLY_WEBHOOK_SIGNING_KEY='...'
