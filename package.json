{
  "name": "base-suite",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test_run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write --plugin prettier-plugin-svelte ./",
    "format_check": "prettier --check --plugin prettier-plugin-svelte ./",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:profiles": "tsx scripts/db.ts profiles",
    "db:admin": "tsx scripts/db.ts admin",
    "db:signin-reset": "tsx scripts/db.ts signin-reset",
    "db:demo": "tsx scripts/db.ts demo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.10",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.21.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.0.9",
    "@tailwindcss/typography": "^0.5.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "daisyui": "^5.0.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.45.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "super-sitemap": "^1.0.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.12.0",
    "kysely": "^0.29.8",
    "marked": "^18.1.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "stripe": "^13.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.0"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  },
  "description": "SvelteKit business platform on SQLite (or Postgres): admin portal, CMS pages and blog, contact inbox, live chat, Calendly booking, newsletter, Stripe subscriptions, CRM and analytics"
}
