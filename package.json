{
  "name": "base-suite",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test_run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write --plugin prettier-plugin-svelte ./",
    "format_check": "prettier --check --plugin prettier-plugin-svelte ./",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:admin": "tsx scripts/db.ts admin"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.21.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.0.9",
    "@tailwindcss/typography": "^0.5.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "daisyui": "^5.0.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.45.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "super-sitemap": "^1.0.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "handlebars": "^4.7.8",
    "kysely": "^0.29.8",
    "marked": "^18.1.2",
    "pg": "^8.23.1",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "stripe": "^13.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.0"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  },
  "description": "SvelteKit business platform on SQLite (or Postgres): admin portal, CMS pages and blog, contact inbox, live chat, Calendly booking, newsletter, Stripe subscriptions, CRM and analytics"
}
